---
import Card from "../ui/Card.astro";
import { FaBity, FaBitcoin, FaBomb } from "react-icons/fa6";
---

<section class:list={["container"]} id="cards">
  <h2 class:list={["text-3xl sm:text-4xl lg:text-5xl", "text-center", "mb-8"]}>
    What You Can Achieve With<br />Carbon Measurement
  </h2>
  <div
    class:list={[
      "grid",
      "grid-cols-1 md:grid-cols-2 xl:grid-cols-3",
      "gap-2 md:gap-4",
    ]}
  >
    <Card
      title="Unlock Revenue"
      text="Tap into new revenue streams and extend gour SaaS offering by meeting the growing customer demand for trusted carbon solutions."
      class:list={["mx-auto"]}
    >
      <FaBity />
    </Card>
    <Card
      title="Unlock Revenue"
      text="Tap into new revenue streams and extend gour SaaS offering by meeting the growing customer demand for trusted carbon solutions."
    >
      <FaBitcoin />
    </Card>
    <Card
      title="Unlock Revenue"
      text="Tap into new revenue streams and extend gour SaaS offering by meeting the growing customer demand for trusted carbon solutions."
    >
      <FaBomb />
    </Card>
  </div>
</section>
