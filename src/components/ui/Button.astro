---
interface Props {
  href: string
  class?: string
}

const { href, class: className = '' } = Astro.props as Props;
---

<a
  href={href}
  class:list={[
    'text-lg',
    'bg-blue-700 hover:bg-transparent',
    'text-white hover:text-blue-700',
    'px-8',
    'py-4',
    'rounded-full',
    'border-2',
    'border-blue-700',
    'duration-300',
    className,
  ]}
>
  <slot />
</a>
