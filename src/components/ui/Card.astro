---
interface Props {
  title: string;
  text: string;
  class?: string;
}

const { title, text, class: className = "" } = Astro.props as Props;
---

<article class:list={["p-6", "shadow-xl", "rounded-2xl", "w-full", "max-w-md", "group", className]}>
  <p
    class:list={[
      "text-5xl group-hover:text-6xl",
      "duration-300", 
      "border-1",
      "border-gray-200",
      "inline-block",
      "p-3",
      "mb-8",
  
    ]}
  >
    <slot/>
  </p>
  <h3 class:list={["text-3xl", "font-bold"]}>{title}</h3>
  <p class:list={["mt-2", "text-justify"]}>
    {text}
  </p>
</article>
