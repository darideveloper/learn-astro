---
import { FaBandcamp } from "react-icons/fa6";
---

<article class:list={["p-6", "shadow-xl", "rounded-2xl", "w-full", "max-w-md"]}>
  <p
    class:list={[
      "text-5xl",
      "border-1",
      "border-gray-200",
      "inline-block",
      "p-3",
      "mb-8",
    ]}
  >
    <FaBandcamp />
  </p>
  <h3 class:list={["text-3xl", "font-bold"]}>Unlock Revenue</h3>
  <p class:list={["mt-2", "text-justify"]}>
    Tap into new revenue streams and extend gour SaaS offering by meeting the
    growing customer demand for trusted carbon solutions.
  </p>
</article>
