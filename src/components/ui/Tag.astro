---
import { FaRegCircleDot } from "react-icons/fa6";

interface Props {
  text: string;
  class?: string;
}

const { text, class: className = "" } = Astro.props;
---

<div class:list={["tag", "inline-block", className]}>
  <div
    class:list={[
      "bg-blue-600/10",
      "flex",
      "justify-center",
      "items-center",
      "rounded-2xl",
      "px-3",
      "py-1",
      "text-sm",
      "gap-2",
      "text-blue-800",
      "group",
    ]}
  >
    <p class:list={["animate-none group-hover:animate-ping"]}>
      <FaRegCircleDot />
    </p>
    <p>{text == "" ? "Carbon Action 2" : text}</p>
  </div>
</div>
